{
	"name": "@margin/ui",
	"version": "0.9.0-beta.2",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./styles/*": "./src/styles/*"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build -o storybook-static --quiet"
	},
	"peerDependencies": {
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@storybook/addon-a11y": "10.6.7",
		"@storybook/react-vite": "10.6.7",
		"storybook": "10.6.7"
	},
	"nx": {
		"targets": {
			"build-storybook": {
				"cache": true,
				"outputs": [
					"{projectRoot}/storybook-static"
				]
			}
		}
	}
}
