{
	"name": "margin-workspace",
	"private": true,
	"packageManager": "pnpm@11.5.2",
	"scripts": {
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm --filter @margin/desktop test",
		"lint": "eslint .",
		"format": "prettier --write .",
		"dev": "pnpm --filter @margin/desktop dev",
		"build": "pnpm --filter @margin/desktop build",
		"test:e2e": "pnpm --filter @margin/desktop test:e2e",
		"import:bible": "pnpm --filter @margin/desktop import:bible",
		"import:lexicon": "pnpm --filter @margin/desktop import:lexicon",
		"dist": "pnpm --filter @margin/desktop dist",
		"dist:release": "pnpm --filter @margin/desktop dist:release"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@floating-ui/dom": "1.8.0",
		"@tailwindcss/vite": "4.3.4",
		"@types/node": "25.9.9",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "5.2.0",
		"eslint": "9.39.5",
		"happy-dom": "21.0.4",
		"prettier": "3.9.10",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tldraw": "5.6.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1",
		"vite": "7.3.7",
		"vitest": "4.1.12"
	}
}
