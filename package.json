{
	"name": "margin-workspace",
	"private": true,
	"packageManager": "pnpm@11.5.2",
	"scripts": {
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm --filter @margin/desktop test",
		"lint": "eslint .",
		"format": "prettier --write .",
		"dev": "pnpm --filter @margin/desktop dev",
		"build": "pnpm --filter @margin/desktop build",
		"test:e2e": "pnpm --filter @margin/desktop test:e2e",
		"import:bible": "pnpm --filter @margin/desktop import:bible",
		"import:lexicon": "pnpm --filter @margin/desktop import:lexicon",
		"dist": "pnpm --filter @margin/desktop dist",
		"dist:release": "pnpm --filter @margin/desktop dist:release"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@floating-ui/dom": "1.8.0",
		"@fontsource/gochi-hand": "5.3.0",
		"@radix-ui/react-alert-dialog": "1.2.1",
		"@radix-ui/react-dialog": "1.3.1",
		"@radix-ui/react-dropdown-menu": "2.2.1",
		"@radix-ui/react-popover": "1.3.1",
		"@radix-ui/react-slider": "1.6.1",
		"@radix-ui/react-toggle-group": "1.2.1",
		"@radix-ui/react-tooltip": "1.4.1",
		"@tailwindcss/vite": "4.3.4",
		"@tldraw/assets": "5.6.0",
		"@types/node": "25.9.9",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "5.2.0",
		"cmdk": "1.1.1",
		"eslint": "9.39.5",
		"happy-dom": "21.0.4",
		"lucide-react": "1.66.0",
		"prettier": "3.9.10",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"sonner": "2.0.8",
		"tailwindcss": "4.3.4",
		"tldraw": "5.6.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1",
		"ulid": "3.0.2",
