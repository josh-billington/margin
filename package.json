{
	"name": "margin",
	"version": "1.0.0",
	"main": "./out/main/index.js",
	"license": "PolyForm-Noncommercial-1.0.0",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@floating-ui/dom": "1.8.0",
		"@fontsource/gochi-hand": "5.3.0",
		"@playwright/test": "1.60.0",
		"@radix-ui/react-alert-dialog": "1.2.1",
		"@radix-ui/react-dialog": "1.3.1",
		"@radix-ui/react-dropdown-menu": "2.2.1",
		"@radix-ui/react-popover": "1.3.1",
		"@radix-ui/react-slider": "1.6.1",
		"@radix-ui/react-toggle-group": "1.2.1",
		"@radix-ui/react-tooltip": "1.4.1",
		"@tailwindcss/vite": "4.3.4",
		"@tldraw/assets": "5.6.0",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "25.9.9",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "5.2.0",
		"cmdk": "1.1.1",
		"electron": "45.2.1",
		"electron-builder": "26.18.0",
		"electron-vite": "6.0.0",
		"eslint": "9.39.5",
		"lucide-react": "1.66.0",
		"prettier": "3.9.10",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"sonner": "2.0.8",
		"tailwindcss": "4.3.4",
		"tldraw": "5.6.0",
		"tsx": "4.23.15",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1",
		"vite": "7.3.7",
		"vitest": "4.1.12",
		"zustand": "5.0.16"
	},
	"dependencies": {
		"better-sqlite3": "13.0.3",
		"chokidar": "6.0.0",
		"electron-liquid-glass": "1.1.1",
		"ulid": "3.0.2",
		"zod": "4.6.7"
	},
	"private": true,
	"description": "A quiet canvas for visual Bible study",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "electron-vite build && playwright test",
		"lint": "eslint .",
		"format": "prettier --write .",
		"import:bible": "tsx scripts/import-bible/index.ts",
		"postinstall": "electron-builder install-app-deps",
		"dist": "yarn build && electron-builder --mac",
		"import:lexicon": "tsx scripts/import-lexicon/index.ts"
	},
	"build": {
		"appId": "com.margin.app",
		"productName": "Margin",
		"directories": {
			"output": "release"
		},
		"files": [
			"out/**/*",
			"package.json",
			"!**/node_modules/better-sqlite3/{deps,src}/**",
			"!**/node_modules/better-sqlite3/prebuilds/{win32,linux,linuxmusl}-*.node",
			"!**/*.map"
		],
		"extraResources": [
			{
				"from": "resources",
				"to": "resources",
				"filter": [
					"**/*"
				]
			}
		],
		"asarUnpack": [
			"**/*.node"
		],
		"mac": {
			"category": "public.app-category.productivity",
			"icon": "resources/icon/margin-dark.icns",
			"identity": "-",
			"hardenedRuntime": false,
			"target": [
				"dmg",
				"zip"
			]
		}
	}
}
