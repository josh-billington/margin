{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node", "vite/client"],
		"baseUrl": ".",
		"paths": {
			"@shared/*": ["src/shared/*"],
			"@renderer/*": ["src/renderer/src/*"]
		}
	},
	"include": ["src", "scripts", "e2e", "playwright.config.ts", "electron.vite.config.ts", "vitest.config.mts"]
}
